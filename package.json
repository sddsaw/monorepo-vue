{
  "name": "soybean-admin",
  "type": "module",
  "version": "2.2.0",
  "description": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  },
  "scripts": {
    "build": "pnpm --filter @sa/admin build && pnpm --filter @sa/student build && pnpm --filter @sa/teacher build",
    "build:admin": "pnpm --filter @sa/admin build",
    "build:student": "pnpm --filter @sa/student build",
    "build:teacher": "pnpm --filter @sa/teacher build",
    "cleanup": "sa cleanup",
    "commit": "git-cz",
    "dev": "pnpm --filter @sa/admin dev",
    "dev:student": "pnpm --filter @sa/student dev",
    "dev:teacher": "pnpm --filter @sa/teacher dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "preview": "pnpm --filter @sa/admin preview",
    "release": "sa release",
    "typecheck": "pnpm --filter @sa/admin typecheck && pnpm --filter @sa/student typecheck && pnpm --filter @sa/teacher typecheck",
    "typecheck:admin": "pnpm --filter @sa/admin typecheck",
    "typecheck:student": "pnpm --filter @sa/student typecheck",
    "typecheck:teacher": "pnpm --filter @sa/teacher typecheck",
    "update-pkg": "sa update-pkg"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@sa/utils": "workspace:*",
    "@soybeanjs/eslint-config-vue": "^0.0.2",
    "@types/node": "25.7.0",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-plugin": "^66.6.8",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vueuse/core": "14.3.0",
    "commitizen": "^4.3.1",
    "consola": "3.4.2",
    "cz-customizable": "^7.5.4",
    "eslint": "10.3.0",
    "kolorist": "1.8.0",
    "lint-staged": "^17.0.7",
    "only-allow": "^1.2.2",
    "sass": "1.99.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.12",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.2",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vue": "3.5.34",
    "vue-tsc": "3.2.8"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1 ",
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix --quiet"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  }
}
