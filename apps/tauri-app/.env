# 应用基础路径
VITE_BASE_URL=/

# 桌面端应用标题与描述
VITE_APP_TITLE=Soybean Desktop
VITE_APP_DESC=Soybean Desktop is a modern cross-platform application based on Tauri v2 and Vue 3

# 图标名称前缀
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local

# 路由权限模式：static (静态) ｜ dynamic (动态)
VITE_AUTH_ROUTE_MODE=static

# 静态路由模式下的主页路由键
VITE_ROUTE_HOME=workbench

# 默认的菜单图标
VITE_MENU_ICON=mdi:menu

# 路由历史模式：hash | history | memory (桌面端默认使用 hash 确保原生窗口加载稳定)
VITE_ROUTER_HISTORY_MODE=hash

# 是否在开发模式下启用 HTTP 代理 (桌面端直连远端 API 时设为 N，结合 Vite 代理开发时设为 Y)
VITE_HTTP_PROXY=N

# 后端服务的成功状态码
VITE_SERVICE_SUCCESS_CODE=0000

# 后端服务的登出状态码
VITE_SERVICE_LOGOUT_CODES=8888,8889
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 超级管理员角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# 本地存储前缀
VITE_STORAGE_PREFIX=SOY_DESKTOP_

# 默认主题色（VSCode 经典蓝）
VITE_THEME_COLOR=#007acc

# 是否生成 sourcemap
VITE_SOURCE_MAP=N

# 是否在终端显示代理请求日志
VITE_PROXY_LOG=Y

# 开发模式下启动时是否自动打开 Redis 调试面板（也可用 Ctrl/Cmd+Alt+R 或 macOS 菜单「视图」手动打开）
VITE_REDIS_DEVTOOLS_AUTO_OPEN=N

# 是否展示工作台底部状态栏（开发环境下展示，Y | N）
VITE_SHOW_STATUS_BAR=Y

# 服务 Base URL
VITE_SERVICE_BASE_URL=https://mock.apifox.cn/m1/3109515-0-default
VITE_APIFOX_TOKEN=XL299LiMEDZ0H5h3A29PxwQXdMJqWyY2
VITE_OTHER_SERVICE_BASE_URL=`{
  "demo": "http://localhost:9528"
}`
