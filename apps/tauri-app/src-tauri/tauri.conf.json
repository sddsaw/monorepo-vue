{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soybean Desktop",
  "version": "2.3.1",
  "identifier": "com.soybean.tauriapp",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:9530",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soybean Desktop",
        "width": 1100,
        "height": 750,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost tauri: https:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["soybean"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/soybeanjs/soybean-admin/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMTExMTExMTExMTExMTEKUldTS3M0b25QbkJvV0VjVVRyZWV4QW9RWW9CZE0rMklsRld4TG1NTHZ5cTRrL2d6K3FqU295YmVhbg=="
    }
  }
}
