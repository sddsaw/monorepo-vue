{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soybean Desktop",
  "version": "0.1.0",
  "identifier": "com.soybean.tauriapp",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:9530",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soybean Desktop",
        "width": 1100,
        "height": 750,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
